{
  "name": "river-room",
  "productName": "River Room",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build --base=./",
    "start": "npm run prepare:engine && npm run build && electron .",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "npm run prepare:engine && npm run build && node scripts/package.mjs",
    "test:desktop": "node --test e2e/*.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/cormorant-garamond": "^5.2.0"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "electron": "45.4.1",
    "@electron/packager": "20.3.0",
    "playwright": "1.65.1"
  }
}
